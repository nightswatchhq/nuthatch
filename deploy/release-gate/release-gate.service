# The release gate's poll (#1749, docs/release-gate.md), as a systemd user unit on the ThinkPad.
# Install: cp deploy/release-gate/release-gate.* ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now release-gate.timer
#          loginctl enable-linger "$USER"   # so the timer runs without a login session
# GATE_NESTS is the nests' config (#1794, nests.conf.example), with a copy, a query set, an
# environment file and a refresh per nest; install-nests-from-mac.sh writes it, and the Helsinki
# export allowlist its refreshes need. Until it exists, every poll exits 2 and gates nothing.
# The query sets are in the private kittiwake repo: the box needs a clone at ~/kittiwake (gh auth as
# cargopete reaches it). `git -C ~/kittiwake pull` before a gate picks up a new set.
# Without GATE_NESTS the runner gates one nest and needs GATE_SET (and GATE_REFRESH to refresh it).
[Unit]
Description=nuthatch release gate: gate the newest ungated release against every production nest's copy

[Service]
Type=oneshot
WorkingDirectory=%h/nuthatch-ops
Environment=GATE_NESTS=%h/release-gate/nests.conf
ExecStart=%h/nuthatch-ops/scripts/release-gate-run.sh --poll
# The QoS nest shares the box: the gate yields CPU and IO to it.
Nice=10
IOSchedulingClass=idle
